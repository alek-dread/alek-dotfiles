#!/usr/bin/env bash
set -eu
umask 077
export LANGUAGE=en LC_ALL=C.UTF-8

# Keep device settings separate from the reinstallable shared configuration.
local_env="${XDG_CONFIG_HOME:-$HOME/.config}/uwsm/env-hyprland.local"
record_encoder_set=${DESKTOP_RECORD_ENCODER+x}
record_device_set=${DESKTOP_RECORD_DEVICE+x}
record_encoder_override=${DESKTOP_RECORD_ENCODER-}
record_device_override=${DESKTOP_RECORD_DEVICE-}
if [[ -r "$local_env" ]]; then source "$local_env"; fi
[[ "$record_encoder_set" != x ]] || export DESKTOP_RECORD_ENCODER="$record_encoder_override"
[[ "$record_device_set" != x ]] || export DESKTOP_RECORD_DEVICE="$record_device_override"

# Software VP8 works without GPU-specific drivers or patent-restricted codecs.
# VA-API H.264 remains an explicit per-machine option.
encoder="${DESKTOP_RECORD_ENCODER:-software}"
# Machine safety policy also covers stale VA-API environment in existing apps.
if [[ "$encoder" == vaapi && "${DESKTOP_RECORD_DISABLE_VAAPI:-0}" == 1 ]]; then encoder=software; fi
case "$encoder" in
    software)
        video_args=(--no-dmabuf -c libvpx -x yuv420p -p deadline=realtime -p cpu-used=4 -p crf=10 -p b=4000000)
        audio_codec=libopus
        extension=webm
        ;;
    vaapi)
        video_args=(-c h264_vaapi -b 0)
        if [[ -n "${DESKTOP_RECORD_DEVICE:-}" ]]; then
            video_args+=(-d "$DESKTOP_RECORD_DEVICE")
        fi
        audio_codec=aac
        extension=mp4
        ;;
    *)
        printf '%s\n' 'DESKTOP_RECORD_ENCODER must be software or vaapi.' >&2
        exit 2
        ;;
esac

runtime="${XDG_RUNTIME_DIR:?}/desktop-record"
mkdir -p "$runtime"
state="$runtime/pid"
logdir="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-record"
mkdir -p "$logdir"

notice() { notify-send -a 'Screen recorder' "$@" || true; }
identity() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
active() {
    [[ -f "$state" ]] || return 1
    read -r pid started < "$state" || return 1
    [[ "$pid" =~ ^[0-9]+$ && "$started" =~ ^[0-9]+$ ]] || return 1
    [[ "$(identity "$pid")" == "$started" ]] || return 1
    [[ "$(cat "/proc/$pid/comm" 2>/dev/null)" == wf-recorder ]]
}

busy() {
    case "$(systemctl --user show desktop-record.service -p ActiveState --value 2>/dev/null)" in
        active|activating|deactivating) return 0 ;;
        *) return 1 ;;
    esac
}

# systemd runs this even if the worker is killed during audio preparation.
if [[ "${1:-}" == _cleanup ]]; then
    "$HOME/.local/bin/desktop-record-menu" --cleanup "$runtime/audio.json"
    rm -f "$state" "$runtime/request" "$runtime/options"
    exit 0
fi

# This worker lives only while recording, waits for the encoder, then exits.
if [[ "${1:-}" == _record ]]; then
    mapfile -d '' -t request < "$runtime/request"
    [[ ${#request[@]} -ge 1 && -n "${request[0]}" ]] || exit 2
    file=${request[0]}
    set -- "${request[@]:1}"
    audio_state="$runtime/audio.json"
    settings_tool="$HOME/.local/bin/desktop-record-menu"
    child=''
    encoding=false
    stop_worker() {
        if [[ -n "$child" ]]; then
            if $encoding; then kill -INT "$child" 2>/dev/null || true
            else kill -TERM "$child" 2>/dev/null || true; exit 1; fi
        else exit 1; fi
    }
    trap stop_worker TERM HUP INT
    "$settings_tool" --prepare "$audio_state" > "$runtime/options" &
    child=$!
    wait "$child" || exit 1
    child=''
    mapfile -t recording_options < "$runtime/options"
    audio_args=()
    if [[ -n "${recording_options[1]:-}" ]]; then
        audio_args=("--audio=${recording_options[1]}" -C "$audio_codec")
    fi
    wf-recorder -r "${recording_options[0]}" "${video_args[@]}" -f "$file" "${audio_args[@]}" "$@" > "$logdir/last.log" 2>&1 &
    child=$!
    encoding=true
    stamp=$(identity "$child") || stamp=''
    if [[ -n "$stamp" ]]; then
        printf '%s %s\n' "$child" "$stamp" > "$state.tmp"
        mv "$state.tmp" "$state"
    fi
    sleep 0.3
    if kill -0 "$child" 2>/dev/null; then
        notice 'Screen recording' 'Recording started. Press Super+Print to stop.'
    fi
    result=0
    while true; do
        wait "$child" && result=0 || result=$?
        kill -0 "$child" 2>/dev/null || break
    done
    child=''
    if [[ "$result" == 0 && -s "$file" ]]; then
        notice 'Recording saved' "$file"
    else
        [[ -s "$file" ]] || rm -f "$file"
        notice -u critical 'Recording failed' "Details: $logdir/last.log"
    fi
    exit "$result"
fi

case "${1:-region}" in region|screen|stop|status) ;; *) exit 2 ;; esac
# Reading the atomically published PID must work even while a region is selected.
if [[ "${1:-}" == status ]]; then
    if active; then printf 'recording\n'
    elif busy; then printf 'starting\n'
    else printf 'idle\n'; fi
    exit 0
fi
if busy; then
    systemctl --user stop --no-block desktop-record.service
    exit 0
fi
exec 9> "$runtime/lock"
flock -n 9 || exit 0
# Recheck after taking the launch lock: another invocation may have started it.
if busy; then
    systemctl --user stop --no-block desktop-record.service
    exit 0
fi
rm -f "$state"
[[ "${1:-}" != stop ]] || exit 0

args=()
case "${1:-region}" in
    region)
        geometry=$(slurp -b 28282880 -c c1a16b -w 2) || exit 0
        # YUV 4:2:0 needs even dimensions; trim at most one pixel at each edge.
        if [[ "$geometry" =~ ^(-?[0-9]+),(-?[0-9]+)\ ([0-9]+)x([0-9]+)$ ]]; then
            width=$(( ${BASH_REMATCH[3]} / 2 * 2 ))
            height=$(( ${BASH_REMATCH[4]} / 2 * 2 ))
            (( width >= 2 && height >= 2 )) || exit 0
            geometry="${BASH_REMATCH[1]},${BASH_REMATCH[2]} ${width}x${height}"
        else
            exit 1
        fi
        args=(-g "$geometry")
        ;;
    screen)
        output=$(hyprctl -j monitors | jq -er '.[] | select(.focused) | .name')
        args=(-o "$output")
        ;;
esac
dir="$(xdg-user-dir VIDEOS)/Recordings"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S)-$$.$extension"
printf '%s\0' "$file" "${args[@]}" > "$runtime/request.tmp"
mv "$runtime/request.tmp" "$runtime/request"
# Type=exec returns once the supervised worker starts. The service remains busy
# throughout preparation, encoding and cleanup, without a PID-publication timeout.
systemctl --user start desktop-record.service

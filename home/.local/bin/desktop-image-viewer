#!/usr/bin/python3
import hashlib
import fcntl
import os
from pathlib import Path
import resource
import subprocess
import sys
import tempfile
import time
from urllib.parse import unquote, urlsplit

MAX_CACHE_BYTES = 512 * 1024 * 1024


def conversion_limits():
    resource.setrlimit(resource.RLIMIT_FSIZE, (256 * 1024 * 1024,) * 2)
    resource.setrlimit(resource.RLIMIT_CPU, (30, 30))


def prune_cache(root, keep):
    entries = []
    for directory in root.iterdir():
        if directory.is_symlink() or not directory.is_dir():
            continue
        for file in directory.glob('*.png'):
            if file.is_symlink():
                continue
            info = file.stat()
            entries.append((info.st_mtime, info.st_size, file))
    total = sum(size for _, size, _ in entries)
    for modified, size, file in sorted(entries):
        if file in keep:
            continue
        if total <= MAX_CACHE_BYTES and modified >= time.time() - 30 * 86400:
            continue
        file.unlink(missing_ok=True)
        total -= size
        try:
            file.parent.rmdir()
        except OSError:
            pass


def main():
    os.environ.update(LANG="en_US.UTF-8", LANGUAGE="en",
                      LC_MESSAGES="en_US.UTF-8", GDK_BACKEND="wayland")
    arguments = []
    cache_root = Path(os.environ.get('XDG_CACHE_HOME', str(Path.home() / '.cache'))) / 'desktop-image-viewer'
    cache_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    keep = set()
    lock = (cache_root / '.lock').open('w')
    fcntl.flock(lock, fcntl.LOCK_EX)
    prune_cache(cache_root, keep)
    for argument in sys.argv[1:]:
        uri = urlsplit(argument) if argument.startswith("file://") else None
        if uri and uri.netloc not in ("", "localhost"):
            arguments.append(argument)
            continue
        path = Path(unquote(uri.path) if uri else argument)
        if path.suffix.lower() in (".jp2", ".j2k", ".jpx", ".xbm") and path.is_file():
            stat = path.stat()
            key = hashlib.sha256(f"{path.absolute()}:{stat.st_mtime_ns}:{stat.st_size}".encode()).hexdigest()
            cache = cache_root / key
            cache.mkdir(parents=True, exist_ok=True)
            target = cache / (path.name + ".png")
            if not target.exists():
                with tempfile.TemporaryDirectory(dir=cache) as temporary:
                    output = Path(temporary) / "image.png"
                    subprocess.run(["/usr/bin/magick", '-limit', 'memory', '128MiB',
                                    '-limit', 'map', '256MiB', '-limit', 'disk', '512MiB',
                                    '-limit', 'width', '32768', '-limit', 'height', '32768',
                                    '-limit', 'area', '64MP', '-limit', 'time', '30',
                                    str(path.absolute()) + "[0]", str(output)],
                                   check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                                   timeout=45, preexec_fn=conversion_limits)
                    output.replace(target)
            argument = str(target)
            keep.add(target)
            if sum(file.stat().st_size for file in keep) > MAX_CACHE_BYTES:
                prune_cache(cache_root, set())
                raise RuntimeError('Converted images exceed the 512 MiB cache limit.')
            os.utime(target, None)
        arguments.append(argument)
    prune_cache(cache_root, keep)
    lock.close()
    os.execv("/usr/bin/ristretto", ["ristretto", *arguments])


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        message = f"Could not open image: {error}"
        print(message, file=sys.stderr)
        subprocess.run(["notify-send", "Ristretto", message], check=False)
        sys.exit(1)

#!/usr/bin/python3
import hashlib
import os
from pathlib import Path
import subprocess
import sys
import tempfile
from urllib.parse import unquote, urlsplit


def main():
    os.environ.update(LANG="en_US.UTF-8", LANGUAGE="en",
                      LC_MESSAGES="en_US.UTF-8", GDK_BACKEND="wayland")
    arguments = []
    for argument in sys.argv[1:]:
        uri = urlsplit(argument) if argument.startswith("file://") else None
        if uri and uri.netloc not in ("", "localhost"):
            arguments.append(argument)
            continue
        path = Path(unquote(uri.path) if uri else argument)
        if path.suffix.lower() in (".jp2", ".j2k", ".jpx", ".xbm") and path.is_file():
            stat = path.stat()
            key = hashlib.sha256(f"{path.absolute()}:{stat.st_mtime_ns}:{stat.st_size}".encode()).hexdigest()
            cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "desktop-image-viewer" / key
            cache.mkdir(parents=True, exist_ok=True)
            target = cache / (path.name + ".png")
            if not target.exists():
                with tempfile.TemporaryDirectory(dir=cache) as temporary:
                    output = Path(temporary) / "image.png"
                    subprocess.run(["/usr/bin/magick", str(path.absolute()) + "[0]", str(output)],
                                   check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
                    output.replace(target)
            argument = str(target)
        arguments.append(argument)
    os.execv("/usr/bin/ristretto", ["ristretto", *arguments])


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.CalledProcessError) as error:
        message = f"Could not open image: {error}"
        print(message, file=sys.stderr)
        subprocess.run(["notify-send", "Ristretto", message], check=False)
        sys.exit(1)

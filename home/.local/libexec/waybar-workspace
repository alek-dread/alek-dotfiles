#!/usr/bin/python3
"""Clickable Waybar workspaces for Hyprland's Lua dispatch API."""

import argparse
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import time


def ipc_path(name):
    return str(Path(os.environ["XDG_RUNTIME_DIR"]) / "hypr" /
               os.environ["HYPRLAND_INSTANCE_SIGNATURE"] / name)


def query(command):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(2)
        connection.connect(ipc_path(".socket.sock"))
        connection.sendall(command.encode())
        chunks = []
        while data := connection.recv(65536):
            chunks.append(data)
    return json.loads(b"".join(chunks))


def render(number, workspaces, active, urgent=False):
    occupied = any(w["id"] == number and w["windows"] > 0 for w in workspaces)
    classes = ["workspace", "occupied" if occupied else "empty"]
    if active == number:
        classes.append("active")
    elif urgent:
        classes.append("urgent")
    return json.dumps({"text": str(number), "class": classes})


def status(number):
    return render(number, query("j/workspaces"), query("j/activeworkspace")["id"])


def watch(number):
    previous = None
    urgent = False
    window_events = {"createworkspacev2", "destroyworkspacev2", "moveworkspacev2",
                     "openwindow", "closewindow", "movewindowv2"}

    def publish(workspaces, active):
        nonlocal previous, urgent
        if active == number:
            urgent = False
        current = render(number, workspaces, active, urgent)
        if current != previous:
            print(current, flush=True)
            previous = current

    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
                connection.connect(ipc_path(".socket2.sock"))
                workspaces = query("j/workspaces")
                active = query("j/activeworkspace")["id"]
                publish(workspaces, active)
                pending = b""
                while True:
                    data = connection.recv(65536)
                    if not data:
                        raise ConnectionError("Hyprland event socket closed")
                    pending += data
                    lines = pending.split(b"\n")
                    pending = lines.pop()
                    refresh_windows = False
                    refresh_active = False
                    for line in lines:
                        event, separator, payload = line.decode().partition(">>")
                        if not separator:
                            continue
                        if event == "workspacev2":
                            active = int(payload.split(",", 1)[0])
                            # Focus feedback must not wait for window-count IPC.
                            publish(workspaces, active)
                        elif event == "focusedmonv2":
                            active = int(payload.split(",", 1)[1])
                            publish(workspaces, active)
                        elif event in window_events:
                            refresh_windows = True
                        elif event == "configreloaded":
                            refresh_windows = refresh_active = True
                        elif event == "urgent":
                            address = payload.removeprefix("0x")
                            clients = query("j/clients")
                            urgent |= any(
                                c["address"].removeprefix("0x") == address
                                and c["workspace"]["id"] == number for c in clients
                            )
                    if refresh_windows:
                        workspaces = query("j/workspaces")
                    if refresh_active:
                        active = query("j/activeworkspace")["id"]
                    publish(workspaces, active)
        except (OSError, ValueError, KeyError, ConnectionError) as error:
            print(f"Workspace status unavailable: {error}", file=sys.stderr)
            time.sleep(2)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("watch", "status", "focus"))
    parser.add_argument("workspace", type=int, choices=range(1, 10))
    args = parser.parse_args()
    if args.action == "focus":
        return subprocess.call([
            "hyprctl", "dispatch", f"hl.dsp.focus({{ workspace = {args.workspace} }})"
        ])
    if args.action == "status":
        print(status(args.workspace))
    else:
        watch(args.workspace)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)

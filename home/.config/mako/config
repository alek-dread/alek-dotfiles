# Arthur: 90u popup width; 3u / 4u content padding; compact 8u icons.
font=Iosevka Aile 11
background-color=#1c1c1c
text-color=#ddeedd
border-color=#554444
border-size=1
border-radius=0
width=360
padding=12,16
margin=0
outer-margin=0
anchor=top-right
default-timeout=5000
max-icon-size=32
max-visible=3
max-history=20

[urgency=critical]
border-color=#cd5c5c
default-timeout=0

[mode=locked]
invisible=1
history=0

set font "Adwaita Mono 11"
set adjust-open "width"
set selection-clipboard "clipboard"
set statusbar-basename true
set window-title-basename true

set default-bg "#282828"
set default-fg "#d4c7ad"
set statusbar-bg "#32302f"
set statusbar-fg "#d4c7ad"
set inputbar-bg "#32302f"
set inputbar-fg "#d4c7ad"

set completion-bg "#282828"
set completion-fg "#d4c7ad"
set completion-group-bg "#32302f"
set completion-group-fg "#8caaa0"
set completion-highlight-bg "#8caaa0"
set completion-highlight-fg "#282828"

set index-bg "#282828"
set index-fg "#d4c7ad"
set index-active-bg "#8caaa0"
set index-active-fg "#282828"

set notification-bg "#32302f"
set notification-fg "#d4c7ad"
set notification-error-bg "#b8796c"
set notification-error-fg "#282828"
set notification-warning-bg "#c1a16b"
set notification-warning-fg "#282828"

set highlight-color "rgba(140,170,160,0.4)"
set highlight-active-color "rgba(179,145,158,0.6)"

set recolor true
set recolor-lightcolor "#282828"
set recolor-darkcolor "#d4c7ad"
set recolor-keephue true
set recolor-reverse-video true

{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "modules-left": [
        "group/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "hyprland/language",
        "pulseaudio",
        "network",
        "clock"
    ],
    "hyprland/window": {
        "format": "{title}",
        "max-length": 70,
        "separate-outputs": true,
        "tooltip": false
    },
    "tray": {
        "icon-size": 14,
        "spacing": 6
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "uwsm app -- pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-ethernet": "NET",
        "format-wifi": "WiFi {signalStrength}%",
        "format-disconnected": "OFFLINE",
        "tooltip-format": "{ifname}: {ipaddr}\n{essid}",
        "on-click": "uwsm app -- alacritty -e nmtui"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%Y-%m-%d}"
    },
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/workspace-1",
            "custom/workspace-2",
            "custom/workspace-3",
            "custom/workspace-4",
            "custom/workspace-5",
            "custom/workspace-6",
            "custom/workspace-7",
            "custom/workspace-8",
            "custom/workspace-9"
        ]
    },
    "custom/workspace-1": {
        "exec": "cat \"$WAYBAR_WORKSPACE_DIR/1.json\"",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "exec-on-event": false,
        "on-click": "\"/home/alek/.local/libexec/waybar-workspace\" focus 1",
        "signal": 1
    },
    "custom/workspace-2": {
        "exec": "cat \"$WAYBAR_WORKSPACE_DIR/2.json\"",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "exec-on-event": false,
        "on-click": "\"/home/alek/.local/libexec/waybar-workspace\" focus 2",
        "signal": 2
    },
    "custom/workspace-3": {
        "exec": "cat \"$WAYBAR_WORKSPACE_DIR/3.json\"",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,

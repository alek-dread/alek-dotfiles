{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "modules-left": [
        "group/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "hyprland/language",
        "pulseaudio",
        "network"
    ],
    "hyprland/window": {
        "format": "{title}",
        "max-length": 38,
        "separate-outputs": true,
        "tooltip": false
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "<span font_family=\"IosevkaTerm Nerd Font Propo\" size=\"12288\"></span>  EN",
        "format-ru": "<span font_family=\"IosevkaTerm Nerd Font Propo\" size=\"12288\"></span>  RU",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "<span font_family=\"IosevkaTerm Nerd Font Propo\" size=\"12288\">{icon}</span>  {volume}%",
        "format-muted": "<span font_family=\"IosevkaTerm Nerd Font Propo\" size=\"12288\"></span>  {volume}%",
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "uwsm app -- pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}\nVolume: {volume}%",
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "network": {
        "format-ethernet": "<span font_family=\"IosevkaTerm Nerd Font Propo\" size=\"12288\"></span>",
        "format-wifi": "<span font_family=\"IosevkaTerm Nerd Font Propo\" size=\"12288\"></span>  {signalStrength}%",
        "format-disconnected": "<span font_family=\"IosevkaTerm Nerd Font Propo\" size=\"12288\"></span>",
        "tooltip-format": "{ifname}: {ipaddr}\n{essid}",
        "on-click": "uwsm app -- alacritty -e nmtui",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ifname} · {ipaddr}",
        "tooltip-format-disconnected": "No network connection",
        "format-disabled": "<span font_family=\"IosevkaTerm Nerd Font Propo\" size=\"12288\"></span>"
    },
    "clock": {
        "format": "<b>{0:%H:%M}</b>  <span color=\"#a89984\">{0:%a, %d %b}</span>",
        "tooltip-format": "<span font_family=\"IosevkaTerm Nerd Font Mono\">{calendar}</span>",
        "locale": "en_GB.UTF-8",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color=\"#d4c7ad\"><b>{}</b></span>",
                "days": "<span color=\"#d4c7ad\">{}</span>",
                "weekdays": "<span color=\"#a89984\">{}</span>",
                "today": "<span color=\"#c1a16b\"><b><u>{}</u></b></span>"
            }
        }
    },
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/workspace-1",
            "custom/workspace-2",
            "custom/workspace-3",
            "custom/workspace-4",
            "custom/workspace-5",
            "custom/workspace-6",
            "custom/workspace-7",
            "custom/workspace-8",
            "custom/workspace-9"
        ]
    },
    "custom/workspace-1": {
        "exec": "cat \"$WAYBAR_WORKSPACE_DIR/1.json\"",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "exec-on-event": false,
        "on-click": "\"/home/alek/.local/libexec/waybar-workspace\" focus 1",
        "signal": 1
    },
    "custom/workspace-2": {
        "exec": "cat \"$WAYBAR_WORKSPACE_DIR/2.json\"",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "exec-on-event": false,
        "on-click": "\"/home/alek/.local/libexec/waybar-workspace\" focus 2",
        "signal": 2
    },
    "custom/workspace-3": {
        "exec": "cat \"$WAYBAR_WORKSPACE_DIR/3.json\"",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "exec-on-event": false,
        "on-click": "\"/home/alek/.local/libexec/waybar-workspace\" focus 3",
        "signal": 3
    },
    "custom/workspace-4": {
        "exec": "cat \"$WAYBAR_WORKSPACE_DIR/4.json\"",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "exec-on-event": false,
        "on-click": "\"/home/alek/.local/libexec/waybar-workspace\" focus 4",
        "signal": 4
    },
    "custom/workspace-5": {
        "exec": "cat \"$WAYBAR_WORKSPACE_DIR/5.json\"",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "exec-on-event": false,
        "on-click": "\"/home/alek/.local/libexec/waybar-workspace\" focus 5",
        "signal": 5
    },
    "custom/workspace-6": {
        "exec": "cat \"$WAYBAR_WORKSPACE_DIR/6.json\"",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "exec-on-event": false,
        "on-click": "\"/home/alek/.local/libexec/waybar-workspace\" focus 6",
        "signal": 6
    },
    "custom/workspace-7": {
        "exec": "cat \"$WAYBAR_WORKSPACE_DIR/7.json\"",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "exec-on-event": false,
        "on-click": "\"/home/alek/.local/libexec/waybar-workspace\" focus 7",
        "signal": 7
    },
    "custom/workspace-8": {
        "exec": "cat \"$WAYBAR_WORKSPACE_DIR/8.json\"",
        "return-type": "json",
        "format": "{text}",
